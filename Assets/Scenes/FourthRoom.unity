      propertyPath: 'messages.Array.data[7]'
      value: With that number youll survive in the next place
      objectReference: {fileID: 0}
    - target: {fileID: 4930517055831265834, guid: 0d82ddcb517decf4c914d4f289440bbd, type: 3}
      propertyPath: 'messages.Array.data[8]'
