  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Level8Controller
  dialogueUI: {fileID: 1731113491}
  interactionDetector: {fileID: 899513069}
  jeffMessages:
  - this is my LAST SIGNAL for you, find an way out
  - and destroy this place before anybody else comes here,
  - i wont see you anymore so i might aswell say it...
  - Im JEFF, i cheated the system but i didnt succeed,
  - so i desided with my last efforts,
  - help YOU succeed,
  - but after the administrators catched me,
  - they turned ME into an twisted experiement,
  - and now im forced to stand still and watch new people get tormented,
  - i only WANTED TO HELP
  - Turn around, go to the exit i made for you...
  - And go INTO THE EXIT
  - I PROMISE YOU, YOU DONT WANT TO STAY!
  - After going to the portal, you will go to the real world
  - In there, get to the main server room!
  - AND DESTROY THIS SIMULATION! PLEASE!
  delayBetweenMessages: 0.4
  jeff2Object: {fileID: 1299264877}
  glimpseAfterMessageIndex: 4
  glimpseVisibleDuration: 2
  lightsToDim:
  - {fileID: 2031908290}
  dimmedIntensity: 25
  dimTransitionDuration: 2
  ambientSource: {fileID: 0}
  ambientDuckVolume: 0.2
  playerMouseLook: {fileID: 899513068}
  lockCameraDuringSpeech: 1
  cameraLockRange: 15
